# --- PostgreSQL (pgvector) ---
# Local dev talks to the db container on localhost; inside docker-compose the app uses host "db".
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASS=change-me
POSTGRES_NAME=hotel_db

# --- LLM ---
# anthropic | openai | gemini   (openai also covers Ollama/vLLM via LLM_BASE_URL)
LLM_PROVIDER=gemini
# optional for anthropic (default claude-opus-5-5), required for openai and gemini
LLM_MODEL=gemini-2.5-flash
# only for OpenAI-compatible local servers, e.g. http://localhost:11434/v1 for Ollama
LLM_BASE_URL=
API_KEY=YOUR_API_KEY

# Print every SQL query (debugging)
DB_ECHO=false
